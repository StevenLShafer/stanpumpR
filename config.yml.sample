default:
  title: "stanpumpR v1.1"
  # Secure defaults for clinical deployments. Server bookmarks use opaque IDs;
  # use "disable" to turn sharing off entirely. Never use "url" for clinical data.
  bookmark_mode: "server"
  allow_url_debug: false
  email_enabled: false
  email_allowed_domains: ["stanfordhealthcare.org"]
  email_smtp_host: "smtp.gmail.com"
  email_smtp_port: 587
  email_smtp_ssl: true
  # Hospitals and other commercial users must supply a valid Handsontable key.
  # See inst/www/handsontable-10.0.0/LICENSE.txt.
  handsontable_license_key: "non-commercial-and-evaluation"
  email_username: "<gmail username>"
  email_password: "<gmail password>"
  help_link: "https://steveshafer.shinyapps.io/stanpumpR_HelpPage"
  debug: 0   # 0 = off, 1 = normal, 2 = verbose
